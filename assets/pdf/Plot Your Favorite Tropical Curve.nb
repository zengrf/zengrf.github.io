Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "tropicalization", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"valuation", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"IntegerExponent", "[", 
      RowBox[{"#", ",", "2"}], "]"}], "&"}], "/@", 
    RowBox[{"Last", "/@", 
     RowBox[{"CoefficientRules", "[", 
      RowBox[{"p", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}]}], "]"}], " ", 
     RowBox[{"(*", 
      RowBox[{
      "this", " ", "function", " ", "brings", " ", "the", " ", "valuation", 
       " ", "of", " ", "every", " ", "coefficient"}], "*)"}]}]}]}]}]], "Input",\

 CellChangeTimes->{{3.932696147470183*^9, 3.932696161075122*^9}},
