Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TropicalPuiseuxPoly", "[", 
    RowBox[{"poly_", ",", "variables_"}], "]"}], ":=", 
   RowBox[{"Max", "@@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Flatten", "/@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"First", "/@", 
           RowBox[{"CoefficientRules", "[", 
            RowBox[{"poly", ",", "variables"}], "]"}]}], ",", 
          RowBox[{"-", 
           RowBox[{"PuiseuxValuation", "/@", 
            RowBox[{"MonomialList", "[", 
             RowBox[{"poly", ",", " ", "variables"}], "]"}]}]}]}], "}"}], 
        "]"}]}], ".", 
      RowBox[{"Append", "[", 
       RowBox[{"variables", ",", "1"}], "]"}]}], ")"}]}]}], "\n"}]], "Input",
