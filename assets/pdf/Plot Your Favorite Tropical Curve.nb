Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MinPlus", "[", "poly_", "]"}], ":=", 
   RowBox[{"ReplaceAll", "[", 
    RowBox[{"poly", ",", 
     RowBox[{"(*", 
      RowBox[{
      "This", " ", "function", " ", "takes", " ", "a", " ", "polynomial", " ",
        "as", " ", "an", " ", "argument", " ", "and", " ", "applies", " ", 
       "the", " ", "MinPlus", " ", "algebra", " ", "on", " ", "it"}], "*)"}], 
     
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Plus", "->", "Min"}], ",", 
       RowBox[{"Times", "->", "Plus"}], ",", 
       RowBox[{"Power", "->", "Times"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MaxPlus", "[", "poly_", "]"}], ":=", 
   RowBox[{"ReplaceAll", "[", 
    RowBox[{"poly", ",", 
     RowBox[{"(*", 
      RowBox[{
      "This", " ", "function", " ", "takes", " ", "a", " ", "polynomial", " ",
        "as", " ", "an", " ", "argument", " ", "and", " ", "applies", " ", 
       "the", " ", "MinPlus", " ", "algebra", " ", "on", " ", "it"}], "*)"}], 
     
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Plus", "->", "Max"}], ",", 
       RowBox[{"Times", "->", "Plus"}], ",", 
       RowBox[{"Power", "->", "Times"}]}], "}"}]}], "]"}]}], ";"}]}], "Input",\

