Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Newton", " ", "Polytope"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"NewtonPolytope", "[", 
    RowBox[{"poly_", ",", "variables_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tpoly", ",", "p", ",", "cs", ",", 
       RowBox[{"P2", "=", "poly"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"p", "=", 
       RowBox[{"First", "/@", 
        RowBox[{"CoefficientRules", "[", 
         RowBox[{"P2", ",", "variables"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"cs", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"IntegerExponent", "[", 
          RowBox[{"#", ",", "2"}], "]"}], "&"}], "/@", 
        RowBox[{"Last", "/@", 
         RowBox[{"CoefficientRules", "[", 
          RowBox[{"P2", ",", "variables"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tpoly", "=", 
       RowBox[{"Flatten", "/@", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"p", ",", "cs"}], "}"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"ListPlot3D", "[", 
         RowBox[{"tpoly", ",", 
          RowBox[{"Mesh", "->", "All"}], ",", 
          RowBox[{"Axes", "->", "True"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", "Yellow", "}"}]}], ",", 
          RowBox[{"Filling", "->", "Bottom"}]}], "]"}], ",", 
        RowBox[{"ListPointPlot3D", "[", "tpoly", "]"}]}], "]"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.932696409858492*^9, 3.932696418290249*^9}},
 CellLabel->
  "In[173]:=",ExpressionUUID->"ca506015-9cb4-40bd-9485-64365e4f528c"],

