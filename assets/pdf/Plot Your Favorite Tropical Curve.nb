Cell[BoxData[{
 RowBox[{
  RowBox[{"TropicalMinPlusPoly", "[", 
   RowBox[{"poly_", ",", "variables_"}], "]"}], ":=", 
  RowBox[{"Min", "@@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Flatten", "/@", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"First", "/@", 
          RowBox[{"CoefficientRules", "[", 
           RowBox[{"poly", ",", "variables"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"IntegerExponent", "[", 
            RowBox[{"#", ",", "2"}], "]"}], "&"}], "/@", 
          RowBox[{"Last", "/@", 
           RowBox[{"CoefficientRules", "[", 
            RowBox[{"poly", ",", "variables"}], "]"}]}]}]}], "}"}], "]"}]}], 
     ".", 
     RowBox[{"Append", "[", 
      RowBox[{"variables", ",", "1"}], "]"}]}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TropicalMaxPlusPoly", "[", 
   RowBox[{"poly_", ",", "variables_"}], "]"}], ":=", 
  RowBox[{"Max", "@@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Flatten", "/@", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"First", "/@", 
          RowBox[{"CoefficientRules", "[", 
           RowBox[{"poly", ",", "variables"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"IntegerExponent", "[", 
            RowBox[{"#", ",", "2"}], "]"}], "&"}], "/@", 
          RowBox[{"Last", "/@", 
           RowBox[{"CoefficientRules", "[", 
            RowBox[{"poly", ",", "variables"}], "]"}]}]}]}], "}"}], "]"}]}], 
     ".", 
     RowBox[{"Append", "[", 
      RowBox[{"variables", ",", "1"}], "]"}]}], ")"}]}]}]}], "Input",
 CellChangeTimes->{{3.932696175427051*^9, 3.9326962281479883`*^9}},
 CellLabel->
  "In[166]:=",ExpressionUUID->"3eac6a16-af68-41d6-ba09-eb3464503ebf"],

