Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Puiseux", " ", "series", " ", "and", " ", "valuations"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"PuiseuxValuation", "[", "expr_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Exponent", "[", 
       RowBox[{"expr", ",", "t", ",", "List"}], "]"}], "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"e", ":", 
          RowBox[{"{", "__", "}"}]}], ":>", 
         RowBox[{"Min", "[", "e", "]"}]}], ",", 
        RowBox[{
         RowBox[{"{", "}"}], "->", 
         RowBox[{"-", "Infinity"}]}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"PuiseuxValuation", "[", 
    RowBox[{
     RowBox[{"1", "/", "t"}], "-", 
     RowBox[{"4", "/", 
      RowBox[{"t", "^", "2"}]}], "+", 
     RowBox[{"5", " ", 
      RowBox[{"t", "^", "2"}]}], "+", 
     RowBox[{"t", "^", "20"}]}], "]"}], "\n", 
   RowBox[{"PuiseuxValuation", "[", 
    RowBox[{
     RowBox[{"8", " ", 
      RowBox[{"t", "^", "6"}]}], "+", 
     RowBox[{"t", "^", "20"}], "+", 
     RowBox[{"t", "^", "7"}]}], "]"}], "\n", 
   RowBox[{"PuiseuxValuation", "[", "0", "]"}], "\[IndentingNewLine]", 
   RowBox[{"PuiseuxValuation", "[", 
    RowBox[{
     RowBox[{"30", 
      RowBox[{"t", "^", 
       RowBox[{"(", 
        RowBox[{"94", "/", "3"}], ")"}]}]}], " ", "-", " ", 
     RowBox[{"59", "/", 
      RowBox[{"(", 
       RowBox[{"t", "^", 
        RowBox[{"(", 
         RowBox[{"98", "/", "5"}], ")"}]}], ")"}]}]}], "]"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", "6"}], "-", "\[Infinity]", " ", "-", 
     RowBox[{"98", "/", "5"}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.932696515896184*^9, 3.93269652111725*^9}, {
